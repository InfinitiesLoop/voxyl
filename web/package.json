{
  "name": "voxyl-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @voxyl/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tools",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "bench:mesh": "node packages/mesher/bench/city.ts",
    "bench:light": "node packages/light/bench/city.ts",
    "bench:sparse": "node packages/light/bench/sparse.ts",
    "shot": "node tools/shot.ts",
    "host": "pnpm --filter @voxyl/server host",
    "golden": "node tools/golden.ts",
    "probe": "node tools/widget-probe/server.ts",
    "relay": "pnpm --filter @voxyl/relay-worker dev",
    "relay:smoke": "node tools/relay-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.1",
    "@voxyl/relay": "workspace:*",
    "fast-check": "^4.10.2",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
