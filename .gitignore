# Voxy stuff
exports/

# Godot 4+ specific ignores
.godot/
.nomedia

# Imported asset library (AssetLibrary.ROOT). These are the user's own MC/resource
# assets, read at runtime — never bundled or committed (see import-feature.md).
/library/
/projects/

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Export builds (see export_presets.cfg)
builds/

# Quickstart video pipeline: local venv, downloaded voice model, rendered output
# (each keeps its .gdignore so Godot never tries to import them)
/quickstart/.venv/*
!/quickstart/.venv/.gdignore
/quickstart/.cache/*
!/quickstart/.cache/.gdignore
/quickstart/out/*
!/quickstart/out/.gdignore
/override.cfg

__pycache__/
*.pyc
